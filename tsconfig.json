{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "rootDir": ".",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@companion/client-sdk": ["packages/client-ts/src/index.ts"],
      "@companion/client-sdk/bootstrap": ["packages/client-ts/src/bootstrap.ts"],
      "@companion/client-sdk/contracts": ["packages/contracts/src/index.ts"],
      "@companion/client-sdk/desktop": ["packages/contracts/src/desktop.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "desktop/**/*.ts",
    "esbuild.mjs",
    "packages/**/*.ts"
  ]
}
